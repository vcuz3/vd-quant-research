# Copy this file to .env in the quant-research repository and fill in your values.
# .env is ignored by Git. Existing process environment variables take precedence.
# Values are literal; quote values containing spaces or #. No variable expansion.

# Required only for Databento estimates and downloads. Leave blank for public data.
DATABENTO_API_KEY=

# IBKR connects to an already authenticated TWS / IB Gateway session.
# No IBKR username or password is stored here. Check your configured API port.
# Usual ports: TWS live 7496 / paper 7497; Gateway live 4001 / paper 4002.
IB_HOST=127.0.0.1
IB_PORT=4001
IB_CLIENT_ID=71

# FRED graph CSV (DGS2 / VIXCLS) and RBA public XLSX need no API credentials.
