# Ignore environment files
.venv/
__pycache__/

# Ignore CSV data at any depth below data/ and bootcamp_exercises
data/**/*.csv
bootcamp_exercises/**/*.csv

# Ignore output png
*.png

# Acquisition secrets and generated artifacts (manifests stay next to raw files).
.env
.env.*
!.env.example
warehouse/meta.sqlite*
warehouse/runs/
warehouse/reports/
warehouse/data/raw/**
!warehouse/data/raw/.gitkeep
warehouse/data/processed/**
!warehouse/data/processed/.gitkeep
